# Copy this file to backend/.env and fill it in. .env is gitignored.
# With NOTHING set the app still runs: JSON-file database, emoji instead of
# photos. Farmers and buyers sign in with phone and password; there is no
# SMS provider. Add credentials to switch each piece on.

# ── Firebase / Firestore ────────────────────────────────────────────
# From the Firebase console:
#   Project settings → Service accounts → Generate new private key
# Option A - paste the three fields (mind the quotes around the key):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Option B - paste the whole downloaded JSON on one line, or base64 of it,
# and leave the three above blank:
# FIREBASE_SERVICE_ACCOUNT=
# Only if you use a named (non-default) Firestore database:
# FIRESTORE_DATABASE_ID=

# ── Cloudinary ──────────────────────────────────────────────────────
# Dashboard → Product Environment Credentials → "API environment variable"
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# All uploads are scoped under this folder:
CLOUDINARY_FOLDER=f2c

# ── The first administrator ─────────────────────────────────────────
# Administrators are records in the database with scrypt-hashed passwords -
# create them with `npm run admin:users create <email> "<name>"`.
#
# These two exist only for a host with no shell, where that command cannot be
# run. While there is NO administrator at all, this one identity may sign in;
# the first successful login writes a real record and these are never consulted
# again. Delete them afterwards.
#
# The second is a HASH, never a password. Generate it with:
#   npm run admin:users hash
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD_HASH=

PORT=4000

# ── Danger: POST /api/dev/reset wipes the database ──────────────────
# Needs this AND a non-production NODE_ENV. Gating on NODE_ENV alone fails
# open, because it is unset by default on most hosts.
ALLOW_DEV_RESET=

# ── Danger: lets one write empty a collection ───────────────────────
# LEAVE THIS BLANK. No single persist may delete more than half a collection,
# because on 10 September 2026 one of them deleted every farmer and every
# product - six real women - and only an hour of Firestore version history got
# them back.
#
# Set it for the one command that means it, never in a .env file:
#   ALLOW_BULK_DELETE=true npm run purge:demo -- --commit
ALLOW_BULK_DELETE=

# ── Session signing ────────────────────────────────────────────
# The key behind EVERY signature in the auth stack: session tokens and the hashes that keep
# phone numbers out of the audit log.
#
# Required in production; development falls back to a fixed dev key.
# CHANGING IT SIGNS EVERYONE OUT - which is also how you revoke every session
# on the platform at once, if you ever need to.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Demo data ──────────────────────────────────────────────
# When the database is EMPTY, load the demo farmers and products from
# seed.ts. Off by default: on a live database this would put invented
# farmers in front of real customers. Turn it on for a fresh local clone.
SEED_DEMO_DATA=

# ── CORS ───────────────────────────────────────────────────
# Which browser origins may call this API. COMMA-SEPARATED, because the
# farmer/customer app and the admin site are deployed separately and both
# call this one backend. No trailing slashes (they are stripped anyway).
# Leave blank in development - blank means any origin.
# CORS_ORIGIN=https://shanta-bazar.vercel.app,https://shanta-admin.vercel.app
CORS_ORIGIN=

# ── Backups: npm run backup ─────────────────────────────────────────
# Copies the live Firestore into a Firebase project on ANOTHER account, and
# the photos into another Cloudinary account. The live project is only read.
# Each run also writes a dated JSON file and new photos to data/backups/.
#
# List the targets, then give each one either half or both. With two or more
# targets, each run copies into ONE of them, rotating by day, so the other
# still holds yesterday. `--to <name>` picks one explicitly.
#
# These keys can WRITE to the backups. Keep them out of the live server's
# environment - only the machine or job that runs the backup needs them.
BACKUP_TARGETS=
# BACKUP_A_FIREBASE_SERVICE_ACCOUNT=
# BACKUP_A_FIRESTORE_DATABASE_ID=
# BACKUP_A_CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Where the local copies go (default backend/data/backups, gitignored):
# BACKUP_DIR=
# Dated database copies older than this many days are pruned, keeping the
# first of each month (default 30):
# BACKUP_KEEP_DAYS=
