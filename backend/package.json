{
  "name": "@f2c/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/fix-shared-imports.js",
    "start": "node --env-file-if-exists=.env dist/backend/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "backfill:customers": "node --import tsx --env-file-if-exists=.env scripts/backfill-customers.ts",
    "purge:demo": "node --import tsx --env-file-if-exists=.env scripts/purge-demo-data.ts",
    "admin:users": "node --import tsx --env-file-if-exists=.env scripts/admins.ts",
    "backup": "node --import tsx --env-file-if-exists=.env scripts/backup.ts",
    "restore": "node --import tsx --env-file-if-exists=.env scripts/restore.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
