# Leave unset in development - Vite proxies /api to http://localhost:4000.
# Set this on the Vercel build, where there is no dev server to proxy through.
# The Android APK loads that same deployed site, so it needs nothing separate.
VITE_API_URL=https://api.shantamahilabazar.in

# ── MSG91 OTP widget ────────────────────────────────────────────────
# Both come from MSG91 dashboard -> OTP -> Widget, and both are public: the
# browser cannot run the widget without them, and everything named VITE_* is
# inlined into the JS bundle that ships to every phone.
#
# NEVER put MSG91_AUTH_KEY here. That one stays in backend/.env - it is what
# lets the server check the widget's token, and in this file it would be
# readable by anyone who opens the app.
#
# Leave both blank and the app uses the server-side OTP path instead, which is
# what a clone with no MSG91 account runs.
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=
# Only if the widget's dashboard is set to something other than 6 digits.
# VITE_MSG91_OTP_LENGTH=6
